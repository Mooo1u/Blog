---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-wrap items-center gap-1">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="p-2 hover:opacity-80 sm:p-1"
        title={social.linkTitle}
      >
        <social.icon class="ui-fade inline-block size-6 fill-transparent stroke-current stroke-2 opacity-90" />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>
