---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import { FRIEND_LINKS } from "@/data/friends";
import { SITE } from "@/config";
---

<Layout title={`友链 | ${SITE.title}`} description="朋友们的站点入口。">
  <Header />
  <Main
    pageTitle="友链"
    pageDesc="这里放一些朋友的站点链接。新增友链时，直接编辑 src/data/friends.ts。"
  >
    <section class="pb-10">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          FRIEND_LINKS.map((friend) => (
            <a
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer"
              class="ui-transition flex items-center gap-4 border border-border bg-background/80 p-4 hover:border-accent hover:bg-background hover:shadow-sm"
            >
              <img
                src={friend.avatar}
                alt={`${friend.id} avatar`}
                width="72"
                height="72"
                class="h-[72px] w-[72px] border border-border object-cover"
                loading="lazy"
              />
              <div class="min-w-0">
                <h2 class="truncate text-lg font-semibold text-accent">
                  {friend.id}
                </h2>
                <p class="mt-1 break-all text-sm text-foreground/70">
                  {friend.url}
                </p>
                <p class="mt-2 text-sm leading-6 text-foreground/85">
                  {friend.signature}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </Main>
  <Footer />
</Layout>
